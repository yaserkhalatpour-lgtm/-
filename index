document
    .getElementById("search")
    .addEventListener(
        "input",
        function() {


            const query =
                this.value
                    .trim()
                    .toLowerCase();


            document
                .querySelectorAll(
                    ".pdf-item"
                )
                .forEach(
                    item => {


                        const visibleText =
                            item
                                .querySelector(
                                    ".pdf-name"
                                )
                                .textContent
                                .toLowerCase();


                        const filename =
                            item.dataset.filename ||
                            "";


                        if (

                            query === ""

                            ||

                            visibleText.includes(
                                query
                            )

                            ||

                            filename.includes(
                                query
                            )

                        ) {

                            item.style.display =
                                "flex";

                        }

                        else {

                            item.style.display =
                                "none";

                        }

                    }
                );

        }
    );


