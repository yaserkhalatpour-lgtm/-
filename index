<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>حل تشریحی سوالات کنکور تجربی</title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {

            font-family:
                Tahoma,
                Arial,
                sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #eef2ff 0%,
                    #f8fafc 50%,
                    #ecfeff 100%
                );

            color: #1e293b;

            min-height: 100vh;
        }


        /* ================= HEADER ================= */

        header {

            background:
                linear-gradient(
                    135deg,
                    #172554,
                    #1d4ed8,
                    #0891b2
                );

            color: white;

            padding: 50px 20px;

            text-align: center;

            box-shadow:
                0 10px 35px
                rgba(0,0,0,.18);
        }


        header h1 {

            font-size: 32px;

            margin-bottom: 15px;
        }


        header h2 {

            font-size: 21px;

            font-weight: normal;

            margin-bottom: 12px;
        }


        header p {

            font-size: 15px;

            opacity: .9;

            line-height: 2;
        }


        /* ================= MAIN ================= */

        .container {

            width: min(1200px, 94%);

            margin: 35px auto;
        }


        /* ================= WELCOME ================= */

        .welcome {

            background: white;

            border-radius: 24px;

            padding: 28px;

            margin-bottom: 30px;

            text-align: center;

            box-shadow:
                0 8px 25px
                rgba(15,23,42,.08);
        }


        .welcome h2 {

            color: #1d4ed8;

            margin-bottom: 12px;

            font-size: 24px;
        }


        .welcome p {

            color: #64748b;

            line-height: 2;
        }


        /* ================= SEARCH ================= */

        .search-box {

            margin-bottom: 20px;
        }


        .search-box input {

            width: 100%;

            padding: 17px 20px;

            border: none;

            border-radius: 16px;

            background: white;

            box-shadow:
                0 5px 20px
                rgba(0,0,0,.08);

            font-size: 16px;

            outline: none;
        }


        .search-box input:focus {

            box-shadow:
                0 0 0 3px
                #93c5fd;
        }


        /* ================= REFRESH ================= */

        .refresh-area {

            text-align: center;

            margin-bottom: 30px;
        }


        .refresh-btn {

            border: none;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #0891b2
                );

            color: white;

            padding: 12px 25px;

            border-radius: 13px;

            font-size: 15px;

            font-weight: bold;

            cursor: pointer;

            box-shadow:
                0 5px 15px
                rgba(37,99,235,.20);

            transition: .2s;
        }


        .refresh-btn:hover {

            transform:
                translateY(-2px);
        }


        /* ================= SECTION ================= */

        .section {

            background: white;

            border-radius: 23px;

            margin-bottom: 28px;

            overflow: hidden;

            box-shadow:
                0 8px 28px
                rgba(15,23,42,.09);
        }


        .section-header {

            padding: 24px;

            color: white;

            cursor: pointer;

            display: flex;

            align-items: center;

            justify-content: space-between;

            user-select: none;
        }


        .section-header h2 {

            font-size: 23px;
        }


        .arrow {

            font-size: 22px;

            transition: .3s;
        }


        .section.open
        .section-content {

            display: block;
        }


        .section-content {

            padding: 25px;

            display: none;
        }


        .section.open
        .arrow {

            transform: rotate(180deg);
        }


        /* ================= COLORS ================= */

        .tenth .section-header {

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #1d4ed8
                );
        }


        .eleventh .section-header {

            background:
                linear-gradient(
                    135deg,
                    #7c3aed,
                    #6d28d9
                );
        }


        .twelfth .section-header {

            background:
                linear-gradient(
                    135deg,
                    #059669,
                    #047857
                );
        }


        .final .section-header {

            background:
                linear-gradient(
                    135deg,
                    #ea580c,
                    #c2410c
                );
        }


        .konkoor .section-header {

            background:
                linear-gradient(
                    135deg,
                    #dc2626,
                    #991b1b
                );
        }


        /* ================= CHAPTERS ================= */

        .chapters {

            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(260px, 1fr)
                );

            gap: 18px;
        }


        .chapter {

            background: #f8fafc;

            border:
                1px solid
                #e2e8f0;

            border-radius: 18px;

            overflow: hidden;

            transition: .3s;
        }


        .chapter:hover {

            transform:
                translateY(-4px);

            box-shadow:
                0 10px 25px
                rgba(0,0,0,.10);
        }


        .chapter-title {

            padding: 17px;

            background: #eff6ff;

            color: #1e40af;

            font-weight: bold;

            cursor: pointer;

            display: flex;

            align-items: center;

            justify-content: space-between;
        }


        .eleventh
        .chapter-title {

            background: #f5f3ff;

            color: #6d28d9;
        }


        .twelfth
        .chapter-title {

            background: #ecfdf5;

            color: #047857;
        }


        .chapter-files {

            padding: 12px;

            display: none;
        }


        .chapter.open
        .chapter-files {

            display: block;
        }


        .chapter-arrow {

            transition: .3s;
        }


        .chapter.open
        .chapter-arrow {

            transform: rotate(180deg);
        }


        /* ================= PDF ================= */

        .pdf-item {

            background: white;

            border:
                1px solid
                #e2e8f0;

            border-radius: 14px;

            padding: 13px;

            margin-bottom: 10px;

            display: flex;

            align-items: center;

            gap: 12px;

            transition: .2s;
        }


        .pdf-item:hover {

            background: #f8fafc;

            transform:
                translateX(-3px);
        }


        .pdf-icon {

            width: 43px;

            height: 43px;

            border-radius: 12px;

            background: #fee2e2;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 21px;

            flex-shrink: 0;
        }


        .pdf-name {

            flex: 1;

            font-weight: bold;

            font-size: 14px;
        }


        .pdf-number {

            display: block;

            margin-top: 4px;

            color: #94a3b8;

            font-size: 12px;

            font-weight: normal;
        }


        .view-btn {

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #1d4ed8
                );

            color: white;

            text-decoration: none;

            padding:
                9px 14px;

            border-radius: 10px;

            font-size: 13px;

            white-space: nowrap;

            transition: .2s;
        }


        .view-btn:hover {

            transform:
                scale(1.05);
        }


        /* ================= EMPTY ================= */

        .empty {

            text-align: center;

            color: #94a3b8;

            padding: 20px;

            font-size: 14px;

            line-height: 2;
        }


        /* ================= LOADING ================= */

        .loading {

            text-align: center;

            color: #64748b;

            padding: 20px;
        }


        .spinner {

            width: 30px;

            height: 30px;

            border:
                4px solid
                #dbeafe;

            border-top-color:
                #2563eb;

            border-radius: 50%;

            margin:
                0 auto 12px;

            animation:
                spin 1s linear infinite;
        }


        @keyframes spin {

            to {

                transform:
                    rotate(360deg);

            }

        }


        /* ================= ERROR ================= */

        .error {

            background: #fef2f2;

            color: #b91c1c;

            border-radius: 12px;

            padding: 15px;

            text-align: center;

            line-height: 2;

            font-size: 14px;
        }


        /* ================= SIMPLE ================= */

        .simple-files {

            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(280px, 1fr)
                );

            gap: 12px;
        }


        /* ================= FOOTER ================= */

        footer {

            text-align: center;

            padding: 35px 15px;

            color: #64748b;

            font-size: 14px;

            line-height: 2;
        }


        .email {

            color: #2563eb;

            text-decoration: none;

            direction: ltr;

            display: inline-block;

            margin-top: 5px;
        }


        /* ================= MOBILE ================= */

        @media (max-width: 600px) {

            header {

                padding: 35px 15px;
            }


            header h1 {

                font-size: 24px;
            }


            header h2 {

                font-size: 17px;
            }


            .section-header h2 {

                font-size: 18px;
            }


            .chapters {

                grid-template-columns: 1fr;
            }


            .pdf-item {

                align-items: center;
            }


            .view-btn {

                padding:
                    8px 10px;

                font-size: 12px;
            }

        }

    </style>

</head>


