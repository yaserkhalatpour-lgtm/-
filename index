<script>


/* =====================================================
   مشخصات GitHub
   ===================================================== */

const GITHUB_OWNER =
    "yaserkhalatpour-lgtm";


const GITHUB_REPO =
    "-";


const GITHUB_BRANCH =
    "main";


/* =====================================================
   فصل‌ها
   ===================================================== */

const chapters = [

    {
        folder: "chapter1",
        title: "فصل اول"
    },

    {
        folder: "chapter2",
        title: "فصل دوم"
    },

    {
        folder: "chapter3",
        title: "فصل سوم"
    },

    {
        folder: "chapter4",
        title: "فصل چهارم"
    },

    {
        folder: "chapter5",
        title: "فصل پنجم"
    },

    {
        folder: "chapter6",
        title: "فصل ششم"
    },

    {
        folder: "chapter7",
        title: "فصل هفتم"
    }

];


/* =====================================================
   باز و بسته کردن بخش
   ===================================================== */

async function toggleSection(header) {


    const section =
        header.parentElement;


    section.classList.toggle("open");


    /*
       وقتی بخش باز می‌شود،
       فایل‌ها مجدداً از GitHub گرفته می‌شوند.
    */

    if (
        section.classList.contains("open")
    ) {


        if (
            section.classList.contains("tenth")
        ) {

            await loadGrade("tenth");

        }


        else if (
            section.classList.contains("eleventh")
        ) {

            await loadGrade("eleventh");

        }


        else if (
            section.classList.contains("twelfth")
        ) {

            await loadGrade("twelfth");

        }


        else if (
            section.classList.contains("final")
        ) {

            await loadSimpleSection(
                "final",
                "final-files"
            );

        }


        else if (
            section.classList.contains("konkoor")
        ) {

            await loadSimpleSection(
                "konkoor",
                "konkoor-files"
            );

        }

    }

}


/* =====================================================
   باز و بسته کردن فصل
   ===================================================== */

function toggleChapter(title) {

    const chapter =
        title.parentElement;

    chapter.classList.toggle("open");

}


/* =====================================================
   دریافت فایل‌های پوشه از GitHub
   ===================================================== */

async function getFolderContents(folder) {


    /*
       زمان فعلی را به URL اضافه می‌کنیم
       تا پاسخ قدیمی Cache نشود.
    */

    const cacheBuster =
        Date.now();


    const apiURL =
        "https://api.github.com/repos/" +
        GITHUB_OWNER +
        "/" +
        GITHUB_REPO +
        "/contents/" +
        folder +
        "?ref=" +
        GITHUB_BRANCH +
        "&cache=" +
        cacheBuster;


    console.log(
        "درخواست GitHub:",
        folder
    );


    const response =
        await fetch(
            apiURL,
            {
                method: "GET",

                cache: "no-store",

                headers: {
                    "Accept":
                        "application/vnd.github+json"
                }
            }
        );


    /*
       این قسمت بسیار مهم است.
       قبلاً خطا را پنهان می‌کردیم
       و پوشه را خالی نشان می‌دادیم.
    */

    if (!response.ok) {


        let message =
            "خطای GitHub";


        if (
            response.status === 404
        ) {

            message =
                "پوشه پیدا نشد یا در شاخه main قرار ندارد.";

        }


        else if (
            response.status === 403
        ) {

            message =
                "دسترسی موقتاً محدود شده است. چند دقیقه بعد دوباره امتحان کنید.";

        }


        else if (
            response.status === 429
        ) {

            message =
                "تعداد درخواست‌ها زیاد شده است. چند دقیقه بعد دوباره امتحان کنید.";

        }


        throw new Error(
            message +
            "  کد خطا: " +
            response.status
        );

    }


    const data =
        await response.json();


    if (
        !Array.isArray(data)
    ) {

        return [];

    }


    /*
       فقط PDFها را می‌گیریم.
       نام فایل هیچ اهمیتی ندارد.
    */

    return data

        .filter(
            file =>
                file.type === "file" &&
                /\.pdf$/i.test(
                    file.name
                )
        )

        .sort(
            (a,b) =>
                a.path.localeCompare(
                    b.path,
                    undefined,
                    {
                        numeric: true,
                        sensitivity: "base"
                    }
                )
        );

}


/* =====================================================
   ساخت آدرس PDF
   ===================================================== */

function getPDFURL(path) {


    const encodedPath =
        path
            .split("/")
            .map(
                part =>
                    encodeURIComponent(part)
            )
            .join("/");


    return (

        "https://" +

        GITHUB_OWNER +

        ".github.io/" +

        encodeURIComponent(
            GITHUB_REPO
        ) +

        "/" +

        encodedPath

    );

}


/* =====================================================
   ساخت کارت PDF
   ===================================================== */

function createPDFCard(
    file,
    number
) {


    const item =
        document.createElement(
            "div"
        );


    item.className =
        "pdf-item";


    /*
       نام واقعی فایل را برای جستجو
       نگه می‌داریم ولی به کاربر نشان نمی‌دهیم.
    */

    item.dataset.filename =
        file.name.toLowerCase();


    const pdfURL =
        getPDFURL(
            file.path
        );


    item.innerHTML = `

        <div class="pdf-icon">
            📄
        </div>


        <div class="pdf-name">

            جزوه ${number}

            <span class="pdf-number">
                فایل PDF
            </span>

        </div>


        <a
            class="view-btn"
            href="${pdfURL}"
            target="_blank"
            rel="noopener noreferrer"
        >

            مشاهده

        </a>

    `;


    return item;

}


/* =====================================================
   بارگذاری پایه
   ===================================================== */

async function loadGrade(
    grade
) {


    const container =
        document.getElementById(
            grade + "-chapters"
        );


    container.innerHTML = `

        <div class="loading">

            <div class="spinner"></div>

            در حال دریافت فایل‌ها از GitHub...

        </div>

    `;


    /*
       همه فصل‌ها را همزمان می‌گیریم
       تا سرعت سایت بیشتر شود.
    */

    try {


        const results =
            await Promise.all(

                chapters.map(
                    async chapter => {

                        const files =
                            await getFolderContents(
                                grade +
                                "/" +
                                chapter.folder
                            );

                        return {
                            chapter,
                            files
                        };

                    }
                )

            );


        container.innerHTML = "";


        results.forEach(
            result => {


                const chapter =
                    result.chapter;


                const files =
                    result.files;


                const box =
                    document.createElement(
                        "div"
                    );


                box.className =
                    "chapter";


                box.innerHTML = `

                    <div
                        class="chapter-title"
                        onclick="toggleChapter(this)"
                    >

                        <span>
                            📖 ${chapter.title}
                        </span>

                        <span class="chapter-arrow">
                            ▼
                        </span>

                    </div>


                    <div class="chapter-files">

                    </div>

                `;


                container.appendChild(
                    box
                );


                const filesBox =
                    box.querySelector(
                        ".chapter-files"
                    );


                if (
                    files.length === 0
                ) {


                    filesBox.innerHTML = `

                        <div class="empty">

                            📂 هنوز فایل PDF
                            در این فصل قرار نگرفته است.

                            <br>

                            فایل را داخل پوشه
                            <b>${grade}/${chapter.folder}</b>
                            قرار بده.

                        </div>

                    `;

                }


                else {


                    files.forEach(
                        (file,index) => {

                            filesBox.appendChild(

                                createPDFCard(
                                    file,
                                    index + 1
                                )

                            );

                        }
                    );

                }

            }
        );


    }


    catch(error) {


        console.error(
            error
        );


        container.innerHTML = `

            <div class="error">

                ❌ دریافت فایل‌ها با مشکل مواجه شد.

                <br><br>

                ${error.message}

                <br><br>

                لطفاً چند لحظه بعد دوباره
                روی همین بخش کلیک کنید.

            </div>

        `;

    }

}


/* =====================================================
   بارگذاری نهایی و کنکور
   ===================================================== */

async function loadSimpleSection(
    folder,
    elementID
) {


    const container =
        document.getElementById(
            elementID
        );


    container.innerHTML = `

        <div class="loading">

            <div class="spinner"></div>

            در حال دریافت فایل‌ها از GitHub...

        </div>

    `;


    try {


        const files =
            await getFolderContents(
                folder
            );


        container.innerHTML = "";


        if (
            files.length === 0
        ) {


            container.innerHTML = `

                <div class="empty">

                    📂 هنوز فایل PDF
                    در پوشه
                    <b>${folder}</b>
                    قرار نگرفته است.

                    <br><br>

                    اگر PDF را تازه اضافه کرده‌ای،
                    چند لحظه بعد دکمه
                    «بروزرسانی فایل‌ها»
                    را بزن.

                </div>

            `;


            return;

        }


        files.forEach(
            (file,index) => {


                container.appendChild(

                    createPDFCard(
                        file,
                        index + 1
                    )

                );

            }
        );


    }


    catch(error) {


        console.error(
            error
        );


        container.innerHTML = `

            <div class="error">

                ❌ خطا در دریافت فایل‌ها

                <br><br>

                ${error.message}

                <br><br>

                لطفاً بررسی کن فایل PDF
                واقعاً داخل پوشه
                <b>${folder}</b>
                و در شاخه
                <b>main</b>
                قرار گرفته باشد.

            </div>

        `;

    }

}


/* =====================================================
