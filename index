   ===================================================== */

async function refreshOpenSections() {


    const button =
        document.querySelector(
            ".refresh-btn"
        );


    const oldText =
        button.innerHTML;


    button.innerHTML =
        "⏳ در حال بروزرسانی...";


    try {


        const sections =
            document.querySelectorAll(
                ".section.open"
            );


        for (
            const section
            of sections
        ) {


            if (
                section.classList.contains(
                    "tenth"
                )
            ) {

                await loadGrade(
                    "tenth"
                );

            }


            else if (
                section.classList.contains(
                    "eleventh"
                )
            ) {

                await loadGrade(
                    "eleventh"
                );

            }


            else if (
                section.classList.contains(
                    "twelfth"
                )
            ) {

                await loadGrade(
                    "twelfth"
                );

            }


            else if (
                section.classList.contains(
                    "final"
                )
            ) {

                await loadSimpleSection(
                    "final",
                    "final-files"
                );

            }


            else if (
                section.classList.contains(
                    "konkoor"
                )
            ) {

                await loadSimpleSection(
                    "konkoor",
                    "konkoor-files"
                );

            }

        }


    }


    finally {


        button.innerHTML =
            oldText;

    }

}


